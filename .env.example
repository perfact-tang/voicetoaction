# ============================================================
# VoiceToAction AI Monitor — 配置模板
#
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 填写下列键值（程序启动时自动读取，无需在页面里上传）
#   3. 启动：./run-ubuntu.sh（服务启动即自动监听 Firestore recordings）
#
# 提示：.env 含服务账号等敏感信息，已在 .gitignore 中，请勿提交。
# ============================================================

# ---- 必填：Firebase Admin 服务账号 JSON 的路径 ----
# （Firebase 控制台 → 项目设置 → 服务账号 → 生成新的私钥，保存后填路径）
FIREBASE_ADMIN_KEY_PATH=/绝对/路径/到/service-account.json

# ---- 必填：Google Drive OAuth 客户端 JSON 的路径 ----
# （Google Cloud 控制台 → 凭据 → OAuth 客户端 ID → 桌面应用 → 下载 JSON）
GOOGLE_OAUTH_CLIENT_PATH=/绝对/路径/到/oauth-client.json

# ---- 可选：Google Docs 默认输出文件夹 ID ----
# （不填则每个录音可用文档的 aicallingid 字段指定；都不填会处理失败）
GOOGLE_DRIVE_FOLDER_ID=

# ---- 只监视这些用户（User ID）的录音 ----
# 多个用英文逗号分隔；留空 = 监视全部用户（不建议）
MONITOR_USER_IDS=uid1,uid2,uid3

# ---- Firestore 记录文档中表示用户 ID 的字段名（默认 uid）----
MONITOR_USER_ID_FIELD=uid

# ---- 转录模型（默认 faster:small）----
# 可选：tiny / base / small / medium / large-v3 / distil-large-v3
WHISPER_MODEL=faster:small

# ============================================================
# Skills（DeepSeek Harness）—— 呼叫对象类型为 deepseek_harness 时走这条流程
# 不再使用 Google Drive：本地 STT → txt 留在本机并备份到 Firebase Storage
# → 用 aiskillsrunner 执行 skill → 回写 Firestore → 推送通知
# ============================================================

# ---- skill 安装目录（只给本后端用，不污染 ~/.agents/skills）----
# 默认：<项目根>/monitor-data/skills
SKILLS_DIR=

# ---- aiskillsrunner（留空 = 用仓库里的 01_aiskillsrunner/aiskillsrunner.js）----
# 后端用同一个 node 执行它，因此不依赖 PATH，也不受全局安装版本影响。
# 想用全局命令时填：SKILLS_RUNNER_BIN=aiskillsrunner
SKILLS_RUNNER_BIN=

# ---- 可选：dsh 可执行文件（默认由 aiskillsrunner 从 PATH 查找）----
# 后端会自动把当前 node 所在目录加到子进程 PATH，通常无需设置。
# 注意：键名不能叫 DSH_BIN（dsh 拒收 .env 里的 DSH_* 变量，见下方说明）。
SKILLS_DSH_BIN=

# ---- 单次 skill 执行超时（毫秒，默认 5400000 = 1.5 小时）----
# 视频渲染类 skill（如 text-to-animation-movie）要跑完依赖安装 + Remotion 渲染，
# 30 分钟会在渲染中途被整组杀掉；按需调大（5400000 = 90 分，10800000 = 3 小时）。
SKILLS_RUNNER_TIMEOUT_MS=5400000

# ---- STT 文本在本机的保存目录（默认 <项目根>/monitor-data/stt）----
STT_OUTPUT_DIR=

# ⚠️ 传给 dsh 的权限模式（默认 danger-full-access）。
# 键名必须用 SKILLS_DSH_PERMISSION_MODE，**不能**写成 DSH_PERMISSION_MODE：
# dsh 会把「工作目录/.env」当作 project 层读取，凡是 DSH_* / XDG_* / DYLD_* /
# BASH_FUNC_* 前缀的变量一律拒收（只允许来自真正 export 的环境变量），
# 一旦写成本名，skill 执行会直接报 “dsh: .../.env sets "DSH_PERMISSION_MODE"” 而失败。
# 后端启动 aiskillsrunner 时会以环境变量 DSH_PERMISSION_MODE 传给 dsh。
SKILLS_DSH_PERMISSION_MODE=danger-full-access

# ---- 任务结束后是否推送 FCM 通知（默认 true；设 false 关闭）----
FCM_ENABLED=true

# ---- skill 产物校验（默认 true，建议保持开启）----
# skill 退出码为 0 时，再独立确认文章真的上传了：从 skill 输出里取 DocID
# （取不到就按输出目录 mtime 兜底），然后查 Firestore mkblog/<DocID> 是否存在。
# 因为 dsh headless 是单回合语义：agent 提前结束回合＝进程退出，仍在跑的后台
# 子代理会被一并杀掉 —— 上传步骤没跑到，但退出码依然是 0，只靠退出码会记成假成功。
# 校验不过时任务记 failed（启动自愈会重试）。设 false 退回旧的「只看退出码」行为。
SKILL_VERIFY_UPLOAD=true

# 需要做产物校验的 skill 名单（逗号分隔）。未设置 = 默认只校验 audio-to-multilingual-blog；
# 想对所有 skill 生效就填 *（此时输出里没有 DocID 的 skill 会被记为失败，慎用）。
SKILL_VERIFY_NAMES=

# ---- 可选：博客文章所在的 Firestore 集合名（默认 mkblog）----
# BLOG_COLLECTION=mkblog

# ---- 可选：服务端口与监听地址 ----
PORT=15888
HOST=0.0.0.0   # 0.0.0.0 = 局域网可访问

# ---- 可选：语音播报 ALSA 输出设备（默认自动尝试 plughw:0,0 / default）----
# AUDIO_DEVICE=plughw:0,0
