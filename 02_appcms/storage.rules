rules_version = '2';

// Shared ruleset for the default Storage bucket (vibecodingjapan.firebasestorage.app).
//
// Firebase Storage keeps exactly ONE ruleset per bucket, and both clients in this
// repository share the same default bucket:
//   - the Android app  -> record/{uid}/**   (03_androidapp/storage.rules)
//   - this CMS         -> skills/{uid}/**   (02_appcms)
// Deploying this file therefore replaces 03_androidapp/storage.rules, so this file
// is the canonical superset of both and must always be deployed from 02_appcms.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isVipUser() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/userinfo/$(request.auth.uid)).data.usertype == 'vip';
    }

    // Android app recordings. Copied unchanged from 03_androidapp/storage.rules.
    match /record/{uid}/{allPaths=**} {
      allow read: if owns(uid);
      allow write: if owns(uid) && isVipUser();
    }

    // Skill packages uploaded from the AI Service management console.
    //
    // The aiskillsrunner backend runs outside Firebase and has no credentials, so
    // a full-path GET is intentionally public: the CMS stores that URL in the
    // service document as `skillZipUrl` and the backend passes it to
    // `aiskillsrunner --installurl`. Listing stays owner-only, and writes require
    // ownership plus a single .zip segment of at most 25 MiB.
    match /skills/{uid}/{fileName} {
      allow get: if true;
      allow list: if owns(uid);
      // `request.resource` is null for deletes, so create/update are validated
      // separately from delete.
      allow create, update: if owns(uid)
        && fileName.matches('^[A-Za-z0-9._-]+[.]zip$')
        && request.resource.size > 0
        && request.resource.size <= 26214400;
      allow delete: if owns(uid);
    }

    // STT 文本备份：Skills（deepseek_harness）流程由后端 monitor.js 用 admin SDK
    // 上传，把 gs:// 地址写回 Firestore。这里只给本人开放读取（App 需要时可下载），
    // 客户端不允许写入。
    match /stt/{uid}/{fileName} {
      allow read: if owns(uid);
      allow write: if false;
    }
  }
}
